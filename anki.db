-- Create users table
CREATE TABLE users (
  id SERIAL PRIMARY KEY,
  username VARCHAR(50) UNIQUE NOT NULL,
  email VARCHAR(100) UNIQUE NOT NULL,
  password_hash VARCHAR(100) NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  -- PostgreSQL text cannot contain NUL; these checks cover the remaining
  -- account identity characters rejected by auth.js before writes.
  CONSTRAINT users_username_trimmed_check CHECK (username = TRIM(username)),
  CONSTRAINT users_username_non_blank_check CHECK (username ~ '[^[:space:]]'),
  CONSTRAINT users_username_safe_characters_check CHECK (
    username !~ U&'[\0001-\001F\007F-\009F\061C\200B-\200F\2028\2029\202A-\202E\2060\2066-\2069\FEFF]'
  ),
  CONSTRAINT users_email_normalized_check CHECK (email = LOWER(TRIM(email))),
  CONSTRAINT users_email_shape_check CHECK (email ~ '^[^@]+@[^@]+$'),
  CONSTRAINT users_email_safe_characters_check CHECK (
    email !~ U&'[[:space:]\0001-\001F\007F-\009F\061C\200B-\200F\2028\2029\202A-\202E\2060\2066-\2069\FEFF]'
  )
);

CREATE UNIQUE INDEX users_normalized_email_unique_idx
  ON users ((LOWER(TRIM(email))));

-- Create decks table. Users own decks; the cascade supports future account erasure
-- by removing personal learning content owned by a deleted user.
CREATE TABLE decks (
  id SERIAL PRIMARY KEY,
  user_id INTEGER NOT NULL CONSTRAINT decks_user_id_fkey REFERENCES users(id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  description TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  -- Keep persisted deck names aligned with deckNameValidation.js.
  CONSTRAINT decks_name_trimmed_check CHECK (
    name = BTRIM(name, U&'\0020\0009\000A\000B\000C\000D\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000\FEFF')
  ),
  CONSTRAINT decks_name_non_blank_check CHECK (
    BTRIM(name, U&'\0020\0009\000A\000B\000C\000D\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000\FEFF') <> ''
  ),
  CONSTRAINT decks_name_safe_characters_check CHECK (
    name !~ U&'[\0001-\001F\007F-\009F\061C\200B\200E\200F\2028\2029\202A-\202E\2060\2066-\2069\FEFF]'
  )
);

CREATE UNIQUE INDEX decks_user_id_normalized_name_unique_idx
  ON decks (user_id, (LOWER(TRIM(name))));

CREATE INDEX decks_user_id_created_at_id_idx
  ON decks (user_id, created_at DESC, id DESC);

-- Create cards table. Decks own cards; deleting a deck removes its card content.
CREATE TABLE cards (
  id SERIAL PRIMARY KEY,
  deck_id INTEGER NOT NULL CONSTRAINT cards_deck_id_fkey REFERENCES decks(id) ON DELETE CASCADE,
  front_content TEXT NOT NULL,
  back_content TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  last_reviewed TIMESTAMP,
  next_review TIMESTAMP,
  interval INTEGER NOT NULL DEFAULT 1,
  review_count INTEGER NOT NULL DEFAULT 0,
  ease_factor FLOAT NOT NULL DEFAULT 2.5,
  -- anki.db is the canonical bootstrap schema for new databases. Existing
  -- deployments must apply the matching migrations before relying on these
  -- persisted content and scheduling invariants.
  CONSTRAINT cards_front_content_non_blank_check CHECK (front_content ~ '[^[:space:]]'),
  CONSTRAINT cards_back_content_non_blank_check CHECK (back_content ~ '[^[:space:]]'),
  CONSTRAINT cards_front_content_max_length_check CHECK (char_length(front_content) <= 10000),
  CONSTRAINT cards_back_content_max_length_check CHECK (char_length(back_content) <= 10000),
  CONSTRAINT cards_interval_min_check CHECK (interval >= 1),
  CONSTRAINT cards_interval_max_check CHECK (interval <= 36500),
  CONSTRAINT cards_review_count_non_negative_check CHECK (review_count >= 0),
  CONSTRAINT cards_ease_factor_min_check CHECK (ease_factor >= 1.3),
  CONSTRAINT cards_review_temporal_order_check CHECK (
    next_review IS NULL OR last_reviewed IS NULL OR next_review > last_reviewed
  )
);

CREATE INDEX cards_deck_id_next_review_idx
  ON cards (deck_id, next_review ASC NULLS FIRST, id ASC);

CREATE INDEX cards_deck_id_created_at_id_idx
  ON cards (deck_id, created_at DESC, id DESC);

CREATE INDEX cards_deck_id_last_reviewed_idx
  ON cards (deck_id, last_reviewed);
