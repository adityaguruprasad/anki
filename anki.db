-- Create users table
CREATE TABLE users (
  id SERIAL PRIMARY KEY,
  username VARCHAR(50) UNIQUE NOT NULL,
  email VARCHAR(100) UNIQUE NOT NULL,
  password_hash VARCHAR(100) NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX users_normalized_email_unique_idx
  ON users ((LOWER(TRIM(email))));

-- Create decks table. Users own decks; the cascade supports future account erasure
-- by removing personal learning content owned by a deleted user.
CREATE TABLE decks (
  id SERIAL PRIMARY KEY,
  user_id INTEGER NOT NULL CONSTRAINT decks_user_id_fkey REFERENCES users(id) ON DELETE CASCADE,
  name VARCHAR(100) NOT NULL,
  description TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX decks_user_id_normalized_name_unique_idx
  ON decks (user_id, (LOWER(TRIM(name))));

CREATE INDEX decks_user_id_created_at_id_idx
  ON decks (user_id, created_at DESC, id DESC);

-- Create cards table. Decks own cards; deleting a deck removes its card content.
CREATE TABLE cards (
  id SERIAL PRIMARY KEY,
  deck_id INTEGER NOT NULL CONSTRAINT cards_deck_id_fkey REFERENCES decks(id) ON DELETE CASCADE,
  front_content TEXT NOT NULL,
  back_content TEXT NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  last_reviewed TIMESTAMP,
  next_review TIMESTAMP,
  interval INTEGER NOT NULL DEFAULT 1,
  review_count INTEGER NOT NULL DEFAULT 0,
  ease_factor FLOAT NOT NULL DEFAULT 2.5,
  -- anki.db is the canonical bootstrap schema for new databases. Existing
  -- deployments must apply the scheduling metadata migration before relying
  -- on these persisted scheduling invariants.
  CONSTRAINT cards_interval_min_check CHECK (interval >= 1),
  CONSTRAINT cards_interval_max_check CHECK (interval <= 36500),
  CONSTRAINT cards_review_count_non_negative_check CHECK (review_count >= 0),
  CONSTRAINT cards_ease_factor_min_check CHECK (ease_factor >= 1.3)
);

CREATE INDEX cards_deck_id_next_review_idx
  ON cards (deck_id, next_review ASC NULLS FIRST, id ASC);

CREATE INDEX cards_deck_id_created_at_id_idx
  ON cards (deck_id, created_at DESC, id DESC);

CREATE INDEX cards_deck_id_last_reviewed_idx
  ON cards (deck_id, last_reviewed);
